# ===================================================
# ENVIRONMENT VARIABLES - CS Enterprise AI Chatbot
# ===================================================
# Salin file ini menjadi .env dan isi dengan nilai asli
# cp .env.example .env

# [WAJIB] Google Gemini API Key
# Dapatkan dari: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [OPSIONAL] Port server (default: 3000)
PORT=3000

# [OPSIONAL] Base URL Aplikasi (Untuk keperluan deploy)
APP_URL=http://localhost:3000
